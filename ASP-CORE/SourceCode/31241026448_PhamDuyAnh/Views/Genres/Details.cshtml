
@model _31241026448_PhamDuyAnh.Models.Genre
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Chi tiết thể loại - CineHub";

    var isAdmin = (await AuthorizationService
        .AuthorizeAsync(User, "ManageCatalog")).Succeeded;
}

<div class="container my-5">

    <div class="rounded text-white p-4 mb-4"
         style="background: linear-gradient(135deg, #111827, #263d60);">

        <h1 class="fw-bold">Chi tiết thể loại</h1>

        <p class="mb-0">CINEHUB. - Movie Store</p>

    </div>

    <div class="card shadow-sm border-0 p-4">

        <p class="text-muted">
            Mã thể loại: #@Model.ID
        </p>

        <h2 class="fw-bold">
            @Model.Name
        </h2>

        <hr />

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                &larr; Danh sách thể loại
            </a>

            <a asp-controller="Movies"
               asp-action="Index"
               class="btn btn-dark">
                Về cửa hàng
            </a>

            @if (isAdmin)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.ID"
                   class="btn btn-outline-primary">
                    Chỉnh sửa
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.ID"
                   class="btn btn-outline-danger">
                    Xóa thể loại
                </a>
            }

        </div>

    </div>

</div>
