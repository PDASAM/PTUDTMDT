
@model _31241026448_PhamDuyAnh.Models.HoaDon

@{
    ViewData["Title"] = "Giỏ hàng - CineHub";
}

<div class="my-4">

    <h1>Giỏ hàng của bạn</h1>

    <p class="text-muted">
        CINEHUB. - Movie Store
    </p>

    @if (Model.ChiTietHoaDons.Count == 0)
    {
        <div class="alert alert-info">
            Giỏ hàng của bạn đang trống.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table id="cartTable"
                   class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Thành tiền</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.ChiTietHoaDons)
                    {
                        <tr>
                            <td>
                                <img src="@item.MovieObj.PicturePath"
                                     alt="@item.MovieObj.Title"
                                     style="width:60px; border-radius:5px;"
                                     class="me-2" />

                                @item.MovieObj.Title
                            </td>

                            <td>
                                <form asp-action="UpdateCart"
                                      method="post"
                                      class="d-flex gap-2">

                                    <input type="hidden"
                                           name="maMovies"
                                           value="@item.MaMovie" />

                                    <input type="number"
                                           name="soLuong"
                                           value="@item.SoLuong"
                                           min="1"
                                           max="99"
                                           class="form-control"
                                           style="width:75px;" />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">
                                        Cập nhật
                                    </button>

                                </form>
                            </td>

                            <td class="text-end">
                                @item.MovieObj.Price.ToString("N0") ₫
                            </td>

                            <td class="text-end">
                                @((item.SoLuong * item.MovieObj.Price).ToString("N0")) ₫
                            </td>

                            <td>
                                <a class="btn btn-outline-danger btn-sm"
                                   asp-action="RemoveFromCart"
                                   asp-route-maMovies="@item.MaMovie">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end">
                            <strong>Tổng tiền:</strong>
                        </td>

                        <td class="text-end text-danger">
                            <strong>
                                @Model.TongTien.ToString("N0") ₫
                            </strong>
                        </td>

                        <td></td>
                    </tr>
                </tfoot>

            </table>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a class="btn btn-outline-secondary"
           asp-action="Index">
            Tiếp tục mua sắm
        </a>

        @if (Model.ChiTietHoaDons.Count > 0)
        {
            <a class="btn btn-primary"
               asp-action="Checkout">
                Thanh toán
            </a>
        }

    </div>

</div>
